# Names only. Keys go in the deployment's environment variables, never in a prompt or in git.

# Preview deployments only: lets the seeded demo accounts sign in. A production deployment that sets it fails its build.
BIOMEG_DEMO=

# R-149. Stays off until the owner, the lead bioanalyst, and counsel confirm it.
BIOMEG_VALUE_CHECK=

# At least 32 characters. Keys the portal's failed sign-in counts.
PORTAL_HASH_SECRET=
